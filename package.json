{
	"name": "todoodle",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun --filter @todoodle/api dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "bun --filter '*' typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/bun": "1.4.4"
	}
}
