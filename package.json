{
	"name": "todoodle",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --parallel --filter '@todoodle/api' --filter '@todoodle/web' dev",
		"build": "bun --filter @todoodle/web build",
		"db:generate": "bun --filter @todoodle/api db:generate",
		"db:migrate": "bun --filter @todoodle/api db:migrate",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "bun --filter '*' typecheck && bun check api"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/bun": "1.4.4"
	}
}
