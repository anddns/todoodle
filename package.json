{
  "name": "todoodle",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@elysia/cors": "1.4.3",
      "drizzle-kit": "1.0.0-rc.5",
      "drizzle-orm": "1.0.0-rc.5",
      "elysia": "1.4.32",
      "postgres": "4.1.1",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun run check && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
